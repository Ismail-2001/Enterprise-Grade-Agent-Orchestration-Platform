# =============================================================================
# The Kubernetes of AI Agents — Environment Variables
# =============================================================================
# Copy to .env and fill with real values. NEVER commit .env
#   cp .env.example .env
#
# Generate secrets:
#   openssl rand -hex 32          # for 64-char hex key
#   openssl rand -base64 32       # for base64 key
#
# CI/CD NOTE: In GitHub Actions, secrets are injected as environment
# variables directly — NEVER written to .env files on disk.
# Only non-secret values (IMAGE_TAG, REGISTRY, LOG_LEVEL, etc.) go to .env.
# =============================================================================

# ─── TLS / mTLS ──────────────────────────────────────────────────────────────
TLS_ENABLED=true
TLS_CERT_DIR=/etc/egaop/certs
# MTLS_ENABLED is off by default. TLS-only mode (requestCert:false) encrypts
# all gRPC traffic. Setting MTLS_ENABLED=true enables client-cert verification
# (requestCert:true) but is currently BLOCKED by an upstream @grpc/grpc-js bug
# (see docs/security.md). Experimental only.
# MTLS_ENABLED=false

# ─── API Server ──────────────────────────────────────────────────────────────
API_SERVER_GRPC_PORT=50051
API_SERVER_REST_PORT=3001
API_SERVER_HEALTH_PORT=15051

# ─── LLM Router ─────────────────────────────────────────────────────────────
# [REQUIRED] API key (OpenAI, Groq, OpenRouter, etc.)
OPENAI_API_KEY=
# [OPTIONAL] Base URL (default: OpenAI). Use Groq: https://api.groq.com/openai/v1
OPENAI_BASE_URL=
# [OPTIONAL] Anthropic API key for Claude models (claude-3-5-sonnet, claude-3-5-haiku, claude-3-opus)
ANTHROPIC_API_KEY=
# [OPTIONAL] Anthropic base URL (default: https://api.anthropic.com)
ANTHROPIC_BASE_URL=
# [OPTIONAL] Ollama server URL for local models (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434
# Fallback chain (comma-separated). Supports: gpt-4o, gpt-4o-mini, gpt-3.5-turbo, claude-3-5-sonnet-20241022, claude-3-5-haiku-20241022, claude-3-opus-20240229, llama3-8b-8192, llama3-70b-8192, mixtral-8x7b-32768
LLM_FALLBACK_CHAIN=gpt-4o,gpt-4o-mini,gpt-3.5-turbo
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=3
RATE_LIMIT_LLM_RPM=30

# ─── Tool Proxy ─────────────────────────────────────────────────────────────
RATE_LIMIT_TOOL_PROXY_RPM=60
# [OPTIONAL] Default API key for tools requiring authentication
TOOL_DEFAULT_API_KEY=
# [OPTIONAL] Per-tool API keys: TOOL_<TOOLNAME>_API_KEY (e.g. TOOL_WEB_SEARCH_API_KEY)
# TOOL_<name>_API_KEY=

# ─── Sandbox Runtime ────────────────────────────────────────────────────────
SANDBOX_RUNTIME_PORT=50054
SANDBOX_RUNTIME_HEALTH_PORT=15054
DOCKER_HOST=unix:///var/run/docker.sock
# [OPTIONAL] Sandbox isolation level: Standard (default Docker), Enhanced (gVisor/runsc), Maximum (firecracker)
SANDBOX_ISOLATION_LEVEL=Enhanced
# [OPTIONAL] Sandbox driver: docker (default) or k8s
SANDBOX_DRIVER=docker
# [OPTIONAL] Max concurrent sandbox containers (default: 10)
SANDBOX_MAX_CONTAINERS=10
# [OPTIONAL] Path to seccomp profile JSON (default: default Docker profile)
SANDBOX_SECCOMP_PROFILE=
# [OPTIONAL] Kubernetes namespace for sandbox pods (default: egaop)
POD_NAMESPACE=egaop

# ─── Memory Plane ───────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# ─── PostgreSQL ─────────────────────────────────────────────────────────────
# [REQUIRED] Use a strong password — never the default in production
POSTGRES_USER=egaop
POSTGRES_PASSWORD=
POSTGRES_DB=egaop
# [OPTIONAL] Full connection string (overrides host/port/db/user/password)
DATABASE_URL=
# [OPTIONAL] Connection pool settings
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# ─── Temporal ───────────────────────────────────────────────────────────────
TEMPORAL_HOST=temporal
TEMPORAL_PORT=7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=egaop-agent-queue

# ─── Policy Plane ──────────────────────────────────────────────────────────
# [REQUIRED] gRPC address of the policy plane (OPA sidecar)
POLICY_PLANE_ADDR=policy-plane:50053

# ─── JWT Authentication ─────────────────────────────────────────────────────
# [REQUIRED] Secret for signing/verifying JWT tokens
# Generate with: openssl rand -hex 32
JWT_SECRET=

# ─── Observability ──────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=egaop
LOG_LEVEL=info

# ─── Secrets ────────────────────────────────────────────────────────────────
# [REQUIRED] 32-byte random key for AES-256-GCM encryption
# Generate with: openssl rand -hex 32
EGAOP_MASTER_ENCRYPTION_KEY=
# [REQUIRED] Shared token for gRPC service-to-service auth (x-service-token)
# Generate with: openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=

# ─── Grafana ────────────────────────────────────────────────────────────────
# [REQUIRED] Use a strong password — never "admin" in production
GRAFANA_USER=admin
GRAFANA_PASSWORD=
# [OPTIONAL] Slack incoming webhook for Grafana alert notifications
# https://api.slack.com/messaging/webhooks
SLACK_ALERT_WEBHOOK=
